# Copy to deploy/.env and fill in the deployment values.
# Generate a different secret for each value, e.g. openssl rand -hex 32.
POSTGRES_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
JWT_SECRET=
BRIEF_AI_TOKEN=

# Private address of the desktop, reachable from the mini PC and its containers.
IDEA2IP_LLM_BASE_URL=
IDEA2IP_LLM_MODEL=idea2ip-vl

APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
