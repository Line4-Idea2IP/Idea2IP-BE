# Copy to /etc/idea2ip/auto-deploy.env (chmod 600). Every value is optional.
# Read-only token that raises the GitHub API rate limit; no write scopes needed.
GITHUB_TOKEN=
# Discord or Slack incoming webhook for deploy results.
IDEA2IP_DEPLOY_WEBHOOK=
# Set to 1 to skip the database backup taken before each deploy.
IDEA2IP_SKIP_BACKUP=
# Set to 1 to only log what would be deployed.
IDEA2IP_DRY_RUN=
